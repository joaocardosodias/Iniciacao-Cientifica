# Copie este arquivo para .env e preencha as chaves que for usar.
# Apenas a chave do provedor escolhido precisa estar preenchida.

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# NVIDIA NIM — https://build.nvidia.com (gerar API Key)
NVIDIA_API_KEY=nvapi-...
