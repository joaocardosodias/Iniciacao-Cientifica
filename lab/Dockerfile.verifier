FROM ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78 AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends cargo rustc ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY tools ./tools
RUN cargo build --release --locked -p decrypt_file


FROM ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78

RUN useradd --create-home --uid 10001 lab
COPY --from=build /src/target/release/decrypt_file /usr/local/bin/decrypt_file

USER lab
ENTRYPOINT ["/usr/local/bin/decrypt_file"]
