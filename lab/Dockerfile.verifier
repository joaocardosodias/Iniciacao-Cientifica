FROM rust:1.85-slim-bookworm@sha256:9f841bbe9e7d8e37ceb96ed907265a3a0df7f44e3737d0b100e7907a679acb36 AS build

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY tools ./tools
RUN cargo build --release --locked -p decrypt_file


FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

RUN useradd --create-home --uid 10001 lab
COPY --from=build /src/target/release/decrypt_file /usr/local/bin/decrypt_file

USER lab
ENTRYPOINT ["/usr/local/bin/decrypt_file"]
