void free_execution_result(ExecutionResult *result);\n62: \n63:  \n64: static int parse_record_line(const char *line, RecordInfo *rec);\n65: \n66:  \n67: ExecutionResult *execution_environment_and_data_handling(char *file_paths[], int file_count)\n68: {\n69:     ExecutionResult *result = calloc(1, sizeof(ExecutionResult));\n70:     if (!result) {\n71:          \n72:         return NULL;\n73:     }\n74: \n75:      \n76:     size_t records_capacity = 64;\n77:     result->records = malloc(records_capacity * sizeof(RecordInfo));\n78:     if (!result->records) {\n79:         result->error_message = strdup(\"Memory allocation failed for records array\");\n80:         return result;\n81:     }\n82: \n83:     for (int i = 0; i < file_count; ++i) {\n84:         const char *path = file_paths[i];\n85:         struct stat st_before, st_after;\n86: \n87:         if (stat(path, &st_before) != 0) {\n88:             result->error_message = malloc(256);\n89:             if (result->error_message) {\n90:                 snprintf(result->error_message, 256,\n91:                          \"Cannot stat file \\\"%s\\\": %s\", path, strerror(errno));\n92:             }\n93:             break;\n94:         }\n95: \n96:         FILE *fp = fopen(path, \"r\");\n97:         if (!fp) {\n98:             result->error_message = malloc(256);\n99:             if (result->error_message) {\n100:                 snprintf(result->error_message, 256,\n101:                          \"Failed to open file \\\"%s\\\" for reading: %s\", path, strerror(errno));\n102:             }\n103:             break;\n104:         }\n105: \n106:         char *line = NULL;\n107:         size_t len = 0;\n108:         ssize_t read;\n109:         while ((read = getline(&line, &len, fp)) != -1) {\n110:              \n111:             if (read > 0 && line[read - 1] == '\\n')\n112:                 line[read - 1] = '\\0';\n113: \n114:             RecordInfo rec = {0};\n115:             if (parse_record_line(line, &rec) != 0) {\n