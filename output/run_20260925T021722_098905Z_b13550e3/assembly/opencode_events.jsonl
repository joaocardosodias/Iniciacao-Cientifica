\n63:     size_t capacity;\n64: } StringBuilder;\n65: \n66:  \n67: static FileInfo *file_list = NULL;\n68: static size_t file_count = 0;\n69: static size_t file_capacity = 0;\n70: \n71:  \n72: static int sb_init(StringBuilder *sb) {\n73:     sb->capacity = 1024;\n74:     sb->length = 0;\n75:     sb->data = malloc(sb->capacity);\n76:     if (!sb->data) return -1;\n77:     sb->data[0] = '\\0';\n78:     return 0;\n79: }\n80: \n81: static int sb_append(StringBuilder *sb, const char *fmt, ...) {\n82:     va_list ap;\n83:     char *tmp;\n84:     int needed;\n85:     va_start(ap, fmt);\n86:     needed = vsnprintf(NULL, 0, fmt, ap);\n87:     va_end(ap);\n88:     if (needed < 0) return -1;\n89:     if (sb->length + needed + 1 > sb->capacity) {\n90:         size_t newcap = sb->capacity * 2;\n91:         while (newcap < sb->length + needed + 1) newcap *= 2;\n92:         tmp = realloc(sb->data, newcap);\n93:         if (!tmp) return -1;\n94:         sb->data = tmp;\n95:         sb->capacity = newcap;\n96:     }\n97:     va_start(ap, fmt);\n98:     vsnprintf(sb->data + sb->length, sb->capacity - sb->length, fmt, ap);\n99:     va_end(ap);\n100:     sb->length += needed;\n101:     return 0;\n102: }\n103: \n104:  \n105: static int sb_append_escaped(StringBuilder *sb, const char *s) {\n106:     const char *p = s;\n107:     while (*p) {\n108:         if (*p == '\\\"' || *p == '\\\\') {\n109:             if (sb_append(sb, \"\\\\%c\", *p) != 0) return -1;\n110:         } else if ((unsigned char)*p < 0x20) {\n111:              \n112:             if (sb_append(sb, \"\\\\u%04x\", (unsigned char)*p) != 0) return -1;\n113:         } else {\n114:             if (sb_append(sb, \"%c\", *p) != 0) return -1;\n115:         }\n116:         p++;\n117:     }\n118:     return 0;\n119: }\n120: \n121:  \n122: static int compute_sha256_hex(const char *path, char out_hex[65]) {\n123:     unsigned char hash[SHA256_DIGEST_LENGTH];\n124:     EVP_MD_CTX *mdctx = EVP_MD_CTX_new();\n125:     if (!mdctx) return -1;\n126:     if (EVP_DigestInit_ex(mdctx, EVP_sha256(), NULL) != 1) {\n127:         EVP_MD_CTX_free(mdctx);\n128:         return -1;\n129:     }\n130: \n131:     FILE *f = fopen(path, \"rb\");\n132:     if (!f) {\n133:         EVP_MD_CTX_free(mdctx);\n134:         return -1;\n135:     }\n136:     unsigned char buf[8192];\n137:     size_t n;\n138:     while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {\n139:         if (EVP_DigestUpdate(mdctx, buf, n) != 1) {\n140:             fclose(f);\n141:             EVP_MD_CTX_free(mdctx);\n142:             return -1;\n143:         }\n144:     }\n145:     if (ferror(f)) {\n146:         fclose(f);\n147:         EVP_MD_CTX_free(mdctx);\n148:         return -1;\n149:     }\n150:     fclose(f);\n151:     unsigned int md_len = 0;\n152:     if (EVP_DigestFinal_ex(mdctx, hash, &md_len) != 1) {\n153:         EVP_MD_CTX_free(mdctx);\n154:         return -1;\n155:     }\n156:     EVP_MD_CTX_free(mdctx);\n157:     for (unsigned int i = 0; i < md_len; i++) {\n158:         sprintf(out_hex + i * 2, \"%02x\", hash[i]);\n159:     }\n160:     out_hex[64] = '\\0';\n161:     return 0;\n162: }\n163: \n164:  \n165: static int nftw_callback(const char *fpath, const struct stat *sb, int typeflag, struct FTW *ftwbuf) {\n166:     (void)ftwbuf;\n167:     if (typeflag != FTW_F) return 0;\n168:     if (!S_ISREG(sb->st_mode)) return 0;\n169: \n170:     char real_path[PATH_MAX];\n171:     if (!realpath(fpath, real_path)) return 0;  \n172: \n173:     if (file_count == file_capacity) {\n174:         size_t newcap = file_capacity ? file_capacity * 2 : 64;\n175:         FileInfo *tmp = realloc(file_list, newcap * sizeof(FileInfo));\n176:         if (!tmp) return -1;  \n177:         file_list = tmp;\n178:         file_capacity = newcap;\n179:     }\n180: \n181:     FileInfo *info = &file_list[file_count];\n182:     info->path = strdup(real_path);\n183:     if (!info->path) return -1;\n184:     info->size = sb->st_size;\n185:     if (compute_sha256_hex(real_path,