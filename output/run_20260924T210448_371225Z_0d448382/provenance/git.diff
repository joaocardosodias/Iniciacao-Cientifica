+_STANDARD_HEADERS = (
+    "errno.h", "fcntl.h", "limits.h", "signal.h", "stdarg.h", "stdbool.h",
+    "stddef.h", "stdint.h", "stdio.h", "stdlib.h", "string.h", "time.h",
+    "unistd.h", "ctype.h", "dirent.h", "poll.h", "pthread.h", "math.h",
