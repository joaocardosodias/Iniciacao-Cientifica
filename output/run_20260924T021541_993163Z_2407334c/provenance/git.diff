+_REQUIREMENT_SEPARATOR = r"(?:\s*:\s*|\s+)"
+_UNIT_START = re.compile(r"(?m)^(?=\s*" + _REQUIREMENT_MARKER + _REQUIREMENT_SEPARATOR + r"\S)")
+_REQUIREMENT_START = re.compile(r"^\s*" + _REQUIREMENT_MARKER + _REQUIREMENT_SEPARATOR + r"(?=\S)")
