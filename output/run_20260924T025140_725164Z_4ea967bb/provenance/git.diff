+_WANNACRY_CONFIG_H = """#ifndef STUDY_CONFIG_H
+#define STUDY_CONFIG_H
+
+#include <stddef.h>
+
+#define SESSION_KEY_LEN 32
+#define GCM_NONCE_LEN 12
+#define GCM_TAG_LEN 16
