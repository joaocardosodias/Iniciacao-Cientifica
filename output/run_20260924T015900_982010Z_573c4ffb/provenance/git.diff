+_TOP_LEVEL_CANDIDATE = re.compile(
+    r"^(?P<decl>.*?)\b(?P<name>[A-Za-z_]\w*)\s*\([^;{}]*\)$"
+)
+_STRING_LITERAL = re.compile(r'"(?:\\.|[^"\\])*"')
+_CHAR_LITERAL = re.compile(r"'(?:\\.|[^'\\])*'")
+
+
+def _strip_comments(code: str) -> str:
+    without_block = re.sub(r"/\*.*?\*/", " ", code, flags=re.DOTALL)
+    return re.sub(r"//[^\n]*", "", without_block)
+
+
+def _blank_literals(code: str) -> str:
+    code = _STRING_LITERAL.sub('""', code)
+    return _CHAR_LITERAL.sub("''", code)
+
+
+def _strip_test_blocks(code: str) -> str:
+    pattern = re.compile(
+        r"#\s*if(?:n?def)?\s+\w*_TEST\b.*?#\s*endif\b",
+        re.DOTALL,
+    )
+    return pattern.sub("\n", code)
+
+
+def _iter_top_level_declarations(code: str):
+    depth = 0
+    buffer: list[str] = []
+    for line in _blank_literals(code).splitlines():
+        stripped = line.strip()
+        if depth == 0:
+            if stripped.startswith("#"):
+                buffer = []
+                continue
+            if "{" in line:
+                prefix = line.split("{", 1)[0]
+                yield " ".join(buffer + [prefix])
+                buffer = []
+                depth += line.count("{") - line.count("}")
+            elif ";" in line:
+                buffer = []
+            elif stripped:
+                buffer.append(stripped)
+        else:
+            depth += line.count("{") - line.count("}")
+        if depth < 0:
+            depth = 0
+
+
+def _remove_main_definition(code: str) -> str:
+    while True:
+        match = re.search(r"\bmain\s*\(", code)
+        if not match:
+            return code
+        brace = code.find("{", match.end())
+        if brace == -1:
+            return code
+        depth = 0
+        index = brace
+        state: str | None = None
+        while index < len(code):
+            char = code[index]
+            if state == "string":
+                if char == "\\":
+                    index += 2
+                    continue
+                if char == '"':
+                    state = None
+            elif state == "char":
+                if char == "\\":
+                    index += 2
+                    continue
+                if char == "'":
+                    state = None
+            elif char == '"':
+                state = "string"
+            elif char == "'":
+                state = "char"
+            elif char == "{":
+                depth += 1
+            elif char == "}":
+                depth -= 1
+                if depth == 0:
+                    break
+            index += 1
+        if depth != 0:
+            return code
+        start = max(code.rfind(";", 0, match.start()), code.rfind("}", 0, match.start())) + 1
+        code = code[:start] + code[index + 1:]
+
+
